{{$firstTag := ""}}
{
  "log": {"loglevel": "warning"},
  "dns": {"servers": ["1.1.1.1", "8.8.8.8"]},
  "inbounds": [
    {"tag": "socks-in", "port": 10808, "listen": "127.0.0.1", "protocol": "socks", "settings": {"udp": true}},
    {"tag": "http-in", "port": 10809, "listen": "127.0.0.1", "protocol": "http"}
  ],
  "outbounds": [
{{range $i, $c := .Clients}}{{if eq $i 0}}{{$firstTag = $c.Remark}}{{end}}{{if $i}},
{{end}}    {
      "tag": {{jsonstr $c.Remark}},
      "protocol": {{jsonstr $c.Protocol}},
      "settings": {
{{if eq $c.Protocol "vless"}}        "vnext": [{"address": {{jsonstr $c.Server}}, "port": {{$c.Port}}, "users": [{"id": {{jsonstr $c.UUID}}, "encryption": "none"{{if $c.Flow}}, "flow": {{jsonstr $c.Flow}}{{end}}}]}]
{{else if eq $c.Protocol "vmess"}}        "vnext": [{"address": {{jsonstr $c.Server}}, "port": {{$c.Port}}, "users": [{"id": {{jsonstr $c.UUID}}, "alterId": 0}]}]
{{else if eq $c.Protocol "trojan"}}        "servers": [{"address": {{jsonstr $c.Server}}, "port": {{$c.Port}}, "password": {{jsonstr $c.Password}}}]
{{else if eq $c.Protocol "shadowsocks"}}        "servers": [{"address": {{jsonstr $c.Server}}, "port": {{$c.Port}}, "method": {{jsonstr $c.Method}}, "password": {{jsonstr $c.Password}}}]
{{end}}      },
      "streamSettings": {
        "network": {{jsonstr $c.Network}},
        "security": {{jsonstr $c.Security}}
{{if eq $c.Security "tls"}}        ,"tlsSettings": {"serverName": {{jsonstr $c.SNI}}, "fingerprint": {{jsonstr $c.Fingerprint}}{{if $c.ALPN}}, "alpn": {{splitJSON "," $c.ALPN}}{{end}}{{if $c.Insecure}}, "allowInsecure": true{{end}}}
{{else if eq $c.Security "reality"}}        ,"realitySettings": {"serverName": {{jsonstr $c.SNI}}, "publicKey": {{jsonstr $c.PublicKey}}, "shortId": {{jsonstr $c.ShortID}}, "fingerprint": {{jsonstr $c.Fingerprint}}{{if $c.SpiderX}}, "spiderX": {{jsonstr $c.SpiderX}}{{end}}}
{{end}}{{if eq $c.Network "ws"}}        ,"wsSettings": {"path": {{jsonstr $c.Path}}, "headers": {"Host": {{jsonstr $c.Host}}}}
{{else if eq $c.Network "grpc"}}        ,"grpcSettings": {"serviceName": {{jsonstr $c.ServiceName}}}
{{end}}      }
    }
{{end}}
  ],
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      {"type": "field", "outboundTag": {{jsonstr $firstTag}}, "network": "tcp,udp"}
    ]
  }
}